{
  "name": "antigravity-rpc",
  "productName": "Antigravity RPC",
  "version": "1.0.0",
  "description": "Desktop control panel for Antigravity Discord Rich Presence (RPC)",
  "main": "main.js",
  "author": "Idris & Antigravity",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^24.8.8",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "electronVersion": "24.8.8",
    "appId": "com.antigravity.rpc",
    "productName": "Antigravity RPC",
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
